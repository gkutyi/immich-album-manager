<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <title>Albumvorschau</title>

    <style>
        body{
            font-family:Arial,sans-serif;
            margin:30px;
            background:#f4f4f4;
        }

        .card{
            background:white;
            padding:20px;
            border-radius:10px;
            box-shadow:0 0 10px #bbb;
        }

        table{
            width:100%;
            border-collapse:collapse;
            margin-top:20px;
        }

        th,td{
            border:1px solid #ccc;
            padding:8px;
            text-align:left;
        }

        th{
            background:#efefef;
        }

        tr:nth-child(even){
            background:#fafafa;
        }

        .ok{
            color:green;
            font-weight:bold;
        }

        .error{
            color:#c00000;
            font-weight:bold;
        }

        .center{
            text-align:center;
        }

        a.button{
            display:inline-block;
            margin-top:20px;
            padding:10px 20px;
            background:#1976d2;
            color:white;
            text-decoration:none;
            border-radius:6px;
        }

        a.button:hover{
            background:#0d5cad;
        }
    </style>

</head>

<body>

<div class="card">

<h2>Albumvorschau</h2>

{% if immich_ok %}
<p class="ok">âœ“ Verbindung zu Immich erfolgreich.</p>
{% else %}
<p class="error">âœ— Verbindung zu Immich fehlgeschlagen.</p>
{% endif %}

<p><b>{{ albums|length }}</b> Alben gefunden.</p>

<table>

<tr>
    <th>Status</th>
    <th>Album</th>
    <th>Regel</th>
    <th>Bilder</th>
    <th>Videos</th>
    <th>Gesamt</th>
    <th>Pfad</th>
</tr>

{% for album in albums %}

<tr>

<td class="center">
{% if album.exists %}
í ½í¿¢
{% else %}
í ½í¿¡
{% endif %}
</td>

<td>
<strong>{{ album.album }}</strong>
{% if album.year %}
<br>
<small>{{ album.year }}</small>
{% endif %}
</td>

<td>{{ album.mode }}</td>

<td>{{ album.images }}</td>

<td>{{ album.videos }}</td>

<td>{{ album.total }}</td>

<td><small>{{ album.path }}</small></td>

</tr>

{% endfor %}

</table>

<br>

<p>
í ½í¿¢ = Album existiert bereits in Immich<br>
í ½í¿¡ = Album wird neu erstellt
</p>

<a class="button" href="/">ZurÃ¼ck</a>

</div>

</body>
</html>